# ---- runtime ----
NODE_ENV=development
PORT=4000

# ---- database ----
# Local Postgres example: postgresql://omnitools:omnitools@localhost:5432/omnitools
DATABASE_URL=postgresql://user:password@localhost:5432/omnitools

# ---- cors ----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# ---- jwt (REQUIRED; ≥32 chars each) ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=please-set-at-least-thirty-two-characters
JWT_REFRESH_SECRET=please-set-at-least-thirty-two-characters-different
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- cookies ----
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- public URLs (used for email verification + reset links) ----
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3100

# ---- email (Phase 4, SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="OmniTools <no-reply@omnitools.example>"

# ---- admin seed (Phase 4) ----
ADMIN_EMAIL=admin@omnitools.example
ADMIN_PASSWORD=change-me-strong

# ---- payments (Phase 9, Razorpay) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- google oauth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- logging ----
LOG_LEVEL=info
